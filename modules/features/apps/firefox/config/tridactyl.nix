# Tridactyl reads its rc and themes through the native messenger, which
# Home Manager links into each platform's Firefox NativeMessagingHosts path.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  p = config.lib.stylix.colors;
  isMac = pkgs.stdenv.hostPlatform.isDarwin;

  # Firefox launched from the Dock or Finder only has the system PATH, so the
  # native messenger must receive absolute paths. editorcmd must stay in the
  # foreground until the editor exits.
  nvim = "${config.home.profileDirectory}/bin/nvim";
  ghostty = config.programs.ghostty.package;
  editorCmd =
    if isMac then
      "/usr/bin/open -nWa ${ghostty}/Applications/Ghostty.app --args -e ${nvim}"
    else
      "${lib.getExe ghostty} -e ${nvim}";
in
{
  programs.firefox.nativeMessagingHosts = [ pkgs.tridactyl-native ];

  xdg.configFile."tridactyl/tridactylrc".text = ''
    " Generated by Nix. Settings changed with :set last until the next restart.
    sanitise tridactyllocal tridactylsync

    colourscheme stylix
    set newtab about:blank
    set smoothscroll true
    set searchengine duckduckgo
    ${lib.optionalString config.programs.ghostty.enable "set editorcmd ${editorCmd}"}

    " Keep Firefox's own find bar.
    unbind <C-f>

    " Vimium-style tab movement.
    bind J tabprev
    bind K tabnext
  '';

  xdg.configFile."tridactyl/themes/stylix.css".text = ''
    :root {
      --tridactyl-font-family: "${config.stylix.fonts.monospace.name}", monospace;
      --tridactyl-bg: #${p.base00};
      --tridactyl-fg: #${p.base05};

      --tridactyl-status-fg: #${p.base05};
      --tridactyl-status-bg: #${p.base01};
      --tridactyl-status-border: 1px solid #${p.base02};

      --tridactyl-search-highlight-color: #${p.base0A};

      --tridactyl-hintspan-font-family: var(--tridactyl-font-family);
      --tridactyl-hintspan-fg: #${p.base00};
      --tridactyl-hintspan-bg: #${p.base0A};
      --tridactyl-hintspan-border-color: #${p.base03};
      --tridactyl-hintspan-active-fg: #${p.base00};
      --tridactyl-hintspan-active-bg: #${p.base09};
      --tridactyl-hint-bg: transparent;
      --tridactyl-hint-outline: 1px solid #${p.base0D};
      --tridactyl-hint-active-fg: #${p.base00};
      --tridactyl-hint-active-bg: #${p.base09};
      --tridactyl-hint-active-outline: 1px solid #${p.base09};

      --tridactyl-cmdl-fg: #${p.base05};
      --tridactyl-cmdl-bg: #${p.base00};
      --tridactyl-cmdl-font-family: var(--tridactyl-font-family);

      --tridactyl-cmplt-fg: #${p.base05};
      --tridactyl-cmplt-bg: #${p.base01};
      --tridactyl-cmplt-font-family: var(--tridactyl-font-family);
      --tridactyl-cmplt-border-top: 1px solid #${p.base02};

      --tridactyl-header-first-bg: #${p.base02};
      --tridactyl-header-second-bg: #${p.base02};
      --tridactyl-header-third-bg: #${p.base02};
      --tridactyl-header-first-fg: #${p.base0D};
      --tridactyl-header-second-fg: #${p.base0D};
      --tridactyl-header-third-fg: #${p.base0D};

      --tridactyl-url-fg: #${p.base0C};
      --tridactyl-url-bg: transparent;
      --tridactyl-of-fg: #${p.base00};
      --tridactyl-of-bg: #${p.base0D};
    }
  '';
}
