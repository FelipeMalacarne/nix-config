[audio]
enable_overdrive = true

[bar.default]
capsule_radius = 7
center = [ "clock", "cpu", "ram", "temp" ]
contact_shadow = true
end = [ "tray", "notifications", "clipboard", "network", "bluetooth", "volume", "brightness", "control-center", "session" ]
margin_edge = 5
margin_ends = 10
start = [ "launcher", "workspaces", "media" ]
widget_spacing = 8

[brightness]
enable_ddcutil = true

[calendar]
enabled = true

    [calendar.account.home_nextcloud]
    color = "primary"
    type = "google"

    [calendar.account.personal_google]
    type = "google"

[desktop_widgets]
schema_version = 2
widget_order = [ "desktop-widget-0000000000000003" ]

    [desktop_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [desktop_widgets.widget.desktop-widget-0000000000000003]
    box_height = 0.0
    box_width = 0.0
    cx = 1744.0
    cy = 337.5
    output = "HDMI-A-2"
    rotation = 0.0
    type = "fancy_audio_visualizer"

        [desktop_widgets.widget.desktop-widget-0000000000000003.settings]
        background = false
        visualization_mode = "wave_rings"

[dock]
auto_hide = true
show_dots = true

[location]
address = "Erechim, Brasil"

[lockscreen_widgets]
enabled = true
schema_version = 2
widget_order = [
    "lockscreen-login-box@DP-1",
    "lockscreen-login-box@HDMI-A-1",
    "lockscreen-login-box@DP-4",
    "lockscreen-login-box@HDMI-A-2",
    "lockscreen-widget-0000000000000001"
]

    [lockscreen_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [lockscreen_widgets.widget."lockscreen-login-box@DP-1"]
    box_height = 0.0
    box_width = 0.0
    cx = 1280.0
    cy = 1317.0
    output = "DP-1"
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@DP-1".settings]
        background_color = "surface_variant"
        background_opacity = 0.88
        background_radius = 12.0
        input_opacity = 1.0
        input_radius = 6.0
        show_login_button = true

    [lockscreen_widgets.widget."lockscreen-login-box@DP-4"]
    box_height = 0.0
    box_width = 0.0
    cx = 1280.0
    cy = 1317.0
    output = "DP-4"
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@DP-4".settings]
        background_color = "surface_variant"
        background_opacity = 0.88
        background_radius = 12.0
        input_opacity = 1.0
        input_radius = 6.0
        show_login_button = true

    [lockscreen_widgets.widget."lockscreen-login-box@HDMI-A-1"]
    box_height = 0.0
    box_width = 0.0
    cx = 1280.0
    cy = 1317.0
    output = "HDMI-A-1"
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@HDMI-A-1".settings]
        background_color = "surface_variant"
        background_opacity = 0.88
        background_radius = 12.0
        input_opacity = 1.0
        input_radius = 6.0
        show_login_button = true

    [lockscreen_widgets.widget."lockscreen-login-box@HDMI-A-2"]
    box_height = 0.0
    box_width = 0.0
    cx = 1280.0
    cy = 1317.0
    output = "HDMI-A-2"
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@HDMI-A-2".settings]
        background_color = "surface_variant"
        background_opacity = 0.88
        background_radius = 12.0
        input_opacity = 1.0
        input_radius = 6.0
        show_login_button = true

    [lockscreen_widgets.widget.lockscreen-widget-0000000000000001]
    box_height = 240.0
    box_width = 736.0
    cx = 1280.0
    cy = 336.0
    output = "DP-1"
    rotation = 0.0
    type = "clock"

        [lockscreen_widgets.widget.lockscreen-widget-0000000000000001.settings]
        background_opacity = 0.0

[notification]
layer = "overlay"

[plugins]
enabled = [ "noctalia/screen_recorder" ]

[shell]
font_family = "Noto Sans"
screen_time_enabled = true
settings_show_advanced = true

    [shell.panel]
    control_center_placement = "floating"
    launcher_session_search = true
    session_placement = "centered"

[theme]
builtin = "Catppuccin"
community_palette = "Oxocarbon"
mode = "dark"
wallpaper_scheme = "m3-tonal-spot"

[wallpaper]
directory = "/home/felipe/Pictures/wallpapers"

    [wallpaper.default]
    path = "/home/felipe/Pictures/wallpapers/catppuccin-mocha.png"

    [wallpaper.last]
    path = "/home/felipe/Pictures/wallpapers/catppuccin-mocha.png"

    [wallpaper.monitors.DP-4]
    path = "/home/felipe/Pictures/wallpapers/catppuccin-mocha.png"

    [wallpaper.monitors.HDMI-A-2]
    path = "/home/felipe/Pictures/wallpapers/catppuccin-mocha.png"

[widget.brightness]
show_label = false

[widget.network]
show_label = false

[widget.sysmon]
capsule = true
show_label = false
stat = "gpu_vram"

[widget.volume]
show_label = false
